  "workflows": [
    {
      "schema_version": 3,
      "id": "ccr-release-validation",
      "name": "CCR Release Validation",
      "description": "Multi-agent validation of a candidate CCR release using XLSX-aware CVAR/GCVAR result comparisons, deal-level backtesting, ErrorByTrade asymmetry analysis, and reusable PR/code forensics.",
      "status": "usable-today-explicit-orchestrated-handoff",
      "owner": "ccr-quant",
      "release_naming": {
        "examples": [
          "release/26.9",
          "release/26.10"
        ],
        "zero_pad_single_digit_minor": false
      },
      "materiality_policy": {
        "threshold_operator": "gt",
        "default_absolute_threshold": 10000.0,
        "default_coverage_target": 0.9,
        "metrics": [
          "Mtf00Gap",
          "EepeInEurGap"
        ]
      },
      "workbook_contract": {
        "result_files": [
          "CcrMetrics.xlsx",
          "CcrMetrics_Gcvar.xlsx"
        ],
        "sheets": {
          "Details": "present in both Ref and Test",
          "Non Ref": "present only in Test/candidate",
          "Non Test": "present only in Ref/production"
        },
        "error_file_pattern": "ErrorByTrade.xlsx",
        "structural_rows_are_material_candidates": true
      },
      "inputs": {
        "required": [
          "production_ref",
          "candidate_ref",
          "cvar_result_workbook"
        ],
        "recommended": [
          "cvar_backtesting_workbook",
          "cvar_error_workbook",
          "cvar_backtesting_error_workbook",
          "gcvar_result_workbook",
          "gcvar_backtesting_workbook",
          "gcvar_error_workbook",
          "gcvar_backtesting_error_workbook",
          "repository"
        ]
      },
      "agents": [
        {
          "id": "ccr-release-validator",
          "phase": "coordinate",
          "role": "Today-facing coordinator: runs deterministic preparation from workbook paths and follows the multi-agent workflow contract."
        },
        {
          "id": "ccr-cvar-release-validator",
          "phase": "validate-cvar",
          "role": "Investigate CVAR MTF00 first, then EEPE, including deal attribution and errors."
        },
        {
          "id": "ccr-gcvar-release-validator",
          "phase": "validate-gcvar",
          "role": "First test whether GCVAR mirrors CVAR; deep-dive only when needed."
        },
        {
          "id": "ccr-release-validation-synthesizer",
          "phase": "root-cause-and-decision",
          "role": "Correlate data/errors/code, identify candidate PRs, and classify expected change vs suspected bug vs inconclusive."
        }
      ],
      "skills": [
        "prepare-ccr-release-evidence",
        "analyze-large-result-diff",
        "backtesting-drilldown",
        "analyze-ccr-errors",
        "release-pr-forensics"
      ],
      "execution": [
        {
          "stage": "prepare-cvar",
          "agent": "ccr-cvar-release-validator",
          "order": [
            "cvar.mtf00",
            "cvar.backtesting.mtf00",
            "cvar.errors.mtf00",
            "cvar.eepe",
            "cvar.backtesting.eepe",
            "cvar.errors.eepe",
            "cvar.mtf00-eepe-link"
          ]
        },
        {
          "stage": "gcvar-precheck",
          "agent": "ccr-gcvar-release-validator",
          "order": [
            "gcvar.result-signature",
            "compare-to-cvar",
            "deep-dive-only-if-needed"
          ]
        },
        {
          "stage": "synthesis",
          "agent": "ccr-release-validation-synthesizer",
          "order": [
            "data-hypotheses",
            "error-explanation",
            "release-pr-forensics",
            "selective-diff-inspection",
            "discriminating-test",
            "classification"
          ]
        }
      ],
      "operating_rules": [
        "Raw XLSX/CSV files are local deterministic-tool inputs only, never normal LLM context.",
        "Strict materiality is abs(gap) > 10000; exactly 10000 is not material.",
        "MTF00 coverage is independent by native currency; EEPE-in-EUR coverage is global.",
        "Backtesting filters impacted Legal Entities first and derives DealId from the TRD segment.",
        {
          "Deal family convention": "no prefix=Equity DPS, ELI-=Equity, other explicit prefix=FIC."
        },
        "Error asymmetry on an impacted LE/deal is evidence, not automatic causality.",
        "EEPE can share MTF00 root cause or be driven by other unseen MTFs / other factors.",
        "GCVAR should reuse CVAR root-cause evidence when deterministic signature similarity is high.",
        "PR ranking is relevance evidence, not proof of causality.",
        "Final material issue classification is expected_dev_change, suspected_bug, or inconclusive."
      ],
      "today_use": {
        "recommended_entry_agent": "ccr-release-validator",
        "execution_model": "The coordinator runs prepare-ccr-release-evidence, then reasons over compact artifacts. Specialized agents remain independently invocable and become natural delegation targets when the enterprise agent platform supports it.",
        "raw_workbooks_in_llm_context": false
      },
      "_file": "ccr-release-validation.yaml"
    }
  ],
  "agents": [
    {
      "id": "ccr-cvar-release-validator",
      "name": "ccr-cvar-release-validator",
      "description": "Specialized CCR agent that validates the CVAR side of a candidate release from CcrMetrics.xlsx, backtesting workbooks and ErrorByTrade workbooks. It investigates MTF00 first, then EEPE, and returns compact evidence for root-cause synthesis."
    },
    {
      "id": "ccr-gcvar-release-validator",
      "name": "ccr-gcvar-release-validator",
      "description": "Specialized CCR agent that validates GCVAR after first checking whether the same signature already exists in CVAR, avoiding redundant expensive backtesting/error analysis when the issue is clearly mirrored."
    },
    {
      "id": "ccr-release-validation-synthesizer",
      "name": "ccr-release-validation-synthesizer",
      "description": "Root-cause and release-validation agent that combines CVAR/GCVAR compact evidence, ErrorByTrade asymmetries and reusable PR forensics to explain material release impacts and classify each issue as expected dev change, suspected bug or inconclusive."
    },
    {
      "id": "ccr-release-validator",
      "name": "ccr-release-validator",
      "description": "Top-level CCR release-validation coordinator for use today in GitHub Copilot. Starting from local CVAR/GCVAR result, backtesting and ErrorByTrade workbook paths, it runs the deterministic evidence pipeline, reasons MTF00-first then EEPE, reuses CVAR evidence for mirrored GCVAR issues, invokes generic PR forensics when available, and produces an evidence-calibrated release-impact report."
    }
  ]
